# ===================================
# 한국 취업 MCP — 환경 설정
# 로컬 LLM 전용 (외부 API 미사용)
# ===================================

# LLM Provider 설정
# 선택: ollama | openai-compatible
LLM_PROVIDER=ollama

# --- Ollama (기본값, 추천) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# 추천 모델: llama3, gemma2, mistral, qwen2.5

# --- OpenAI 호환 로컬 서버 (LM Studio, vLLM 등) ---
# LLM_PROVIDER=openai-compatible
# LOCAL_LLM_BASE_URL=http://localhost:1234/v1
# LOCAL_LLM_MODEL=local-model
# LOCAL_LLM_API_KEY=not-needed

# DB 경로 (기본: ./data/job_hunting.db)
DB_PATH=./data/job_hunting.db

# 사람인 API (선택사항 — 사람인 공고 검색 시 필요)
# SARAMIN_API_KEY=your-saramin-api-key

# ===================================
# 기업 성장성 분석 (company_analyze 도구)
# ===================================

# DART OpenAPI 키 (필수 — 재무제표·기업공시 조회)
# 용도: 매출·영업이익·부채비율 등 연도별 재무 추이 분석
#       국내 상장사 및 외부감사 대상 비상장사 모두 지원
# 발급: https://opendart.fss.or.kr/ 회원가입 후 [OpenAPI] 신청 (무료, 즉시 발급)
# 주의: DART는 한국 금감원 공식 사이트이며, 이 키는 재무 데이터 조회 전용입니다.
#       OpenAI 등 다른 API 키와 혼동하지 마세요.
# DART_API_KEY=your-dart-api-key

# 네이버 검색 API — Client ID (필수 — 기업 뉴스/보도 검색)
# 용도: 최근 N일간 기업 관련 언론 보도를 검색하여 성장 신호 파악
# 발급: https://developers.naver.com/apps/ 에서 [애플리케이션 등록]
#       → 사용 API: [검색] 선택 → 완료 후 Client ID/Secret 확인
#       (무료, 일 25,000건 한도)
# NAVER_NEWS_CLIENT_ID=your-naver-client-id

# 네이버 검색 API — Client Secret (위 Client ID와 쌍으로 사용)
# 용도: NAVER_NEWS_CLIENT_ID 인증을 위한 시크릿 키
#       Client ID 발급 시 함께 발급되며, 절대 외부에 노출하지 마세요.
# NAVER_NEWS_CLIENT_SECRET=your-naver-client-secret
